Scheme Dijkstra {
    // Замена 999999999 на 0 в итоговом массиве расстояний
    Fun replaceInf {
        arr = [1];
        N = [2];
        i = [3];

        @ = (i * N).equal -> arr,
        ((arr * i).arrayGet * 999999999).equal -> ((arr * i * 0).arraySet * N * (i * 1).add).replaceInf,
        (arr * N * (i * 1).add).replaceInf;
    }

    // Обновление расстояний до соседей текущей вершины u
    Fun updateNeighbors {
        dist = [1];
        visited = [2];
        graph = [3];
        N = [4];
        u = [5];
        v = [6];

        nextV = (v * 1).add;
        edgeIdx = ((u * N).mul * v).add;

        @ = (v * N).equal -> dist,
        ((visited * v).arrayGet * 0).equal -> (
            ((graph * edgeIdx).arrayGet * 0).greater -> (
                ((((dist * u).arrayGet * (graph * edgeIdx).arrayGet).add) * (dist * v).arrayGet).less ->
                ((dist * v * (((dist * u).arrayGet * (graph * edgeIdx).arrayGet).add)).arraySet * visited * graph * N * u * nextV).updateNeighbors,
                                                         (dist * visited * graph * N * u * nextV).updateNeighbors
            ),
            (dist * visited * graph * N * u * nextV).updateNeighbors
        ),
        (dist * visited * graph * N * u * nextV).updateNeighbors;
    }

    // Поиск непосещенной вершины с минимальным расстоянием
    Fun findMin {
        dist = [1];
        visited = [2];
        N = [3];
        i = [4];
        min_val = [5];
        min_idx = [6];

        nextI = (i * 1).add;

        @ = (i * N).equal -> min_idx,
        (((visited * i).arrayGet * 0).equal * ((dist * i).arrayGet * min_val).less).and ->
        (dist * visited * N * nextI * (dist * i).arrayGet * i).findMin,
        (dist * visited * N * nextI * min_val * min_idx).findMin;
    }

    // Цикл алгоритма Дейкстры для одного источника
    Fun dijkstraLoop {
        dist = [1];
        visited = [2];
        graph = [3];
        N = [4];
        step = [5];

        u = (dist * visited * N * 0 * 999999999 * 0).findMin;
        u_dist = (dist * u).arrayGet;
        new_visited = (visited * u * 1).arraySet;
        new_dist = (dist * new_visited * graph * N * u * 0).updateNeighbors;

        @ = (step * N).equal -> dist,
        (u_dist * 999999999).equal -> dist,
        (new_dist * new_visited * graph * N * (step * 1).add).dijkstraLoop;
    }

    // Запуск Дейкстры для одной исходной вершины
    Fun singleSource {
        src = [1];
        N = [2];
        graph = [3];

        init_dist = (N * 999999999).arrayCreate;
        dist = (init_dist * src * 0).arraySet;
        visited = (N * 0).arrayCreate;

        res = (dist * visited * graph * N * 0).dijkstraLoop;
        @ = (res * N * 0).replaceInf;
    }

    // Запуск для всех пар вершин.
    // Важно: результат уже содержит первую строку, поэтому src начинается с 1.
    Fun allPairs {
        src = [1];
        N = [2];
        graph = [3];
        result = [4];

        nextSrc = (src * 1).add;

        @ = (src * N).equal -> result,
        (nextSrc * N * graph * (result * (src * N * graph).singleSource).arrayCat).allPairs;
    }

    inFile = [1];
    N = [2].toInt;
    size = (N * N).mul;

    graph = (inFile * (size * 0).arrayCreate).openFile;

    // Начальный аккумулятор не может быть пустым.
    // Поэтому сразу вычисляем нулевую строку и передаем ее как начальный результат.
    firstRow = (0 * N * graph).singleSource;
    resultMatrix = (1 * N * graph * firstRow).allPairs;

    @ = resultMatrix;
}

Application
%Dijkstra
