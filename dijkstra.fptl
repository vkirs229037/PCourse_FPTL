Scheme Dijkstra {
    // Целочисленный корень.
    // Ищем такое i, что i * i == x.
    Fun isqrt {
        x = [1];
        i = [2];

        sq = (i * i).mul;
        next = (i * 1).add;

        @ = (sq * x).equal -> i,
            (sq * x).greater -> (i * 1).sub,
            (x * next).isqrt;
    }

    // Замена 999999999 на 0 для недостижимых вершин
    Fun replaceInf {
        arr = [1];
        N = [2];
        i = [3];

        nextI = (i * 1).add;

        @ = (i * N).less -> (
                ((arr * i).arrayGet * 999999999).equal ->
                    ((arr * i * 0).arraySet * N * nextI).replaceInf,
                (arr * N * nextI).replaceInf
            ),
            arr;
    }

    // Обновление расстояний до соседей вершины u
    Fun updateNeighbors {
        dist = [1];
        visited = [2];
        graph = [3];
        N = [4];
        u = [5];
        v = [6];

        nextV = (v * 1).add;
        edgeIdx = ((u * N).mul * v).add;
        graphLen = graph.arrayLen;

        @ = (u * N).less -> (
                ((v * N).less * (edgeIdx * graphLen).less).and -> (
                    ((visited * v).arrayGet * 0).equal -> (
                        ((graph * edgeIdx).arrayGet * 0).greater -> (
                            ((((dist * u).arrayGet * (graph * edgeIdx).arrayGet).add) * (dist * v).arrayGet).less ->
                                ((dist * v * (((dist * u).arrayGet * (graph * edgeIdx).arrayGet).add)).arraySet * visited * graph * N * u * nextV).updateNeighbors,
                            (dist * visited * graph * N * u * nextV).updateNeighbors
                        ),
                        (dist * visited * graph * N * u * nextV).updateNeighbors
                    ),
                    (dist * visited * graph * N * u * nextV).updateNeighbors
                ),
                dist
            ),
            dist;
    }

    // Поиск непосещенной вершины с минимальным расстоянием.
    // Если такой нет, возвращается N.
    Fun findMin {
        dist = [1];
        visited = [2];
        N = [3];
        i = [4];
        best_dist = [5];
        best_idx = [6];

        nextI = (i * 1).add;

        @ = (i * N).less -> (
                ((visited * i).arrayGet * 0).equal -> (
                    ((dist * i).arrayGet * best_dist).less ->
                        (dist * visited * N * nextI * (dist * i).arrayGet * i).findMin,
                    (dist * visited * N * nextI * best_dist * best_idx).findMin
                ),
                (dist * visited * N * nextI * best_dist * best_idx).findMin
            ),
            best_idx;
    }

    // Цикл Дейкстры для одного источника
    Fun dijkstraLoop {
        dist = [1];
        visited = [2];
        graph = [3];
        N = [4];
        step = [5];

        uRaw = (dist * visited * N * 0 * 999999999 * N).findMin;

        // Защитное значение, чтобы случайные выходы за границу не приводили к падению
        u = (uRaw * N).less -> uRaw, 0;
        nextStep = (step * 1).add;

        @ = (step * N).equal -> dist,
            (uRaw * N).less -> (
                (((dist * u).arrayGet * 999999999).equal -> dist,
                 ((dist * (visited * u * 1).arraySet * graph * N * u * 0).updateNeighbors *
                  (visited * u * 1).arraySet * graph * N * nextStep).dijkstraLoop)
            ),
            dist;
    }

    // Дейкстра для одной исходной вершины
    Fun singleSource {
        src = [1];
        N = [2];
        graph = [3];

        init_dist = (N * 999999999).arrayCreate;
        dist = (init_dist * src * 0).arraySet;
        visited = (N * 0).arrayCreate;

        res = (dist * visited * graph * N * 0).dijkstraLoop;
        @ = (res * N * 0).replaceInf;
    }

    // Все пары: первая строка уже есть в result, поэтому начинаем с 1
    Fun allPairs {
        src = [1];
        N = [2];
        graph = [3];
        result = [4];

        nextSrc = (src * 1).add;

        @ = (src * N).less ->
                (nextSrc * N * graph * (result * (src * N * graph).singleSource).arrayCat).allPairs,
            result;
    }

    inFile = [1];
    N = [2].toInt;

    // Размер буфера для чтения файла.
    // Если второй аргумент — число вершин, то размер графа равен N * N.
    size = (N * N).mul;

    graph = (inFile * (size * 0).arrayCreate).openFile;

    // Дополнительно определяем число вершин по фактической длине графа.
    // Это защищает от случая, когда передали размер файла, а не число вершин.
    vertexN = (graph.arrayLen * 0).isqrt;

    firstRow = (0 * vertexN * graph).singleSource;
    resultMatrix = (1 * vertexN * graph * firstRow).allPairs;

    @ = (resultMatrix * "result.txt").createFile * "result written".printLine;
}

Application
%Dijkstra
