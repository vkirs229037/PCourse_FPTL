// Кратчайшие пути между всеми парами вершин: алгоритм Флойда-Уоршелла.
//
// Формат входного файла (целые числа через пробелы/переводы строк):
//   N
//   w11 w12 ... w1N
//   ...
//   wN1 wN2 ... wNN
// wij - вес дуги i->j (может быть отрицательным); 0 вне диагонали = дуги нет;
// диагональ игнорируется.
//
// Результат: матрица N x N расстояний; 0 - если j недостижима из i.
// Если в графе есть цикл отрицательного веса, печатается сообщение об этом.
//
// Параллельная версия (обновление на месте, блоками строк):
// на шаге K строка K и столбец K не меняются (D[K][K] = 0), поэтому задача,
// обрабатывающая строку I, читает только строки I и K и пишет только в строку I.
// Строки делятся на Parts блоков (рекурсивно пополам, как в Parallel_QuickSort.fptl);
// блоки одного шага K выполняются параллельно, внутри блока - последовательно.
// Запись идёт прямо в строки матрицы и только при улучшении расстояния.
//
// Parts - число параллельных блоков; разумно ставить равным числу потоков
// интерпретатора (см. Fun Parts ниже). Parts = 1 - полностью последовательный расчёт.

Scheme FloydWarshall
{
	@ = [1].readFile.(id -> Parse.Solve, "File not found!\n".print);

	// (text) -> (W * N)
	Parse = ([1] * "-?[0-9]+").getToken.([1].toInt * [2]).
			((([1] * ([1] * 0).arrayCreate).arrayCreate * [1] * 0 * [2]).ReadMatr * [1]);

	// (W * N) -> матрица расстояний (без вывода, чтобы не учитывать I/O во времени).
	// Чтобы снова печатать результат: ([1] * [2] * 0).MatrToText.print вместо [1]
	// после "." кортеж: [1]=D [2]=N
	Solve = (([1] * [2] * 0 * Parts).Floyd * [2]).
			(([1] * [2] * 0).HasNegDiag -> "Error: graph contains a negative cycle\n".print,
										  [1]);

	// "бесконечность"
	Fun Inf
	{
		@ = 1000000000;
	}

	// число параллельных блоков строк на каждом шаге K
	Fun Parts
	{
		@ = 8;
	}

	// ---------------- чтение графа ----------------

	// (w * i * j) -> вес во внутреннем представлении
	Fun ToWeight
	{
		W = [1];
		I = [2];
		J = [3];

		@ = (I * J).equal -> 0,
			(W * 0).equal -> Inf,
			W;
	}

	// (Row * N * I * J * Text) -> (Row * Rest)
	Fun ReadRow
	{
		Row = [1];
		N = [2];
		I = [3];
		J = [4];
		Text = [5];

		@ = (J * N).equal -> Row * Text,
			((Text * "-?[0-9]+").getToken.(id -> [1] * [2], "0" * "") * Row * N * I * J).
				(([3] * [6] * ([1].toInt * [5] * [6]).ToWeight).arraySet * [4] * [5] * ([6] * 1).add * [2]).ReadRow;
	}

	// (M * N * I * Text) -> M
	Fun ReadMatr
	{
		M = [1];
		N = [2];
		I = [3];
		Text = [4];

		@ = (I * N).equal -> M,
			(((N * 0).arrayCreate * N * I * 0 * Text).ReadRow * M * N * I).
				(([3] * [5] * [1]).arraySet * [4] * ([5] * 1).add * [2]).ReadMatr;
	}

	// ---------------- алгоритм Флойда-Уоршелла ----------------

	// внешний цикл по K: (D * N * K * P) -> D
	// шаги по K идут последовательно: шагу K+1 нужна вся матрица шага K.
	// После "." кортеж: [1]=число обработанных строк [2]=D [3]=N [4]=K [5]=P;
	// "." дожидается завершения всех блоков шага K, и только потом начинается шаг K+1.
	Fun Floyd
	{
		D = [1];
		N = [2];
		K = [3];
		P = [4];

		@ = (K * N).equal -> D,
			((D * N * K * 0 * N * P).Block * D * N * K * P).
				([2] * [3] * ([4] * 1).add * [5]).Floyd;
	}

	// (D * N * K * Lo * Hi * P) -> число обработанных строк
	// обрабатывает строки Lo..Hi-1, разбивая их на P блоков.
	// При P > 1 оба операнда "*" рекурсивны - половины считаются параллельно;
	// они пишут в разные строки D, поэтому не мешают друг другу.
	Fun Block
	{
		D = [1];
		N = [2];
		K = [3];
		Lo = [4];
		Hi = [5];
		P = [6];

		Mid = ((Lo * Hi).add * 2).div;
		LP = (P * 2).div;
		RP = (P * LP).sub;

		@ = (P * 1).greater ->
				((D * N * K * Lo * Mid * LP).Block * (D * N * K * Mid * Hi * RP).Block).add,
			(D * N * K * Lo * Hi * 0).RowsSeq;
	}

	// (D * N * K * I * Hi * Cnt) -> Cnt + (Hi - I)
	// последовательно обновляет строки I..Hi-1 (одна задача на весь блок):
	// в кортеже перед "." рекурсивна только UpdRow, поэтому новых задач не создаётся.
	Fun RowsSeq
	{
		D = [1];
		N = [2];
		K = [3];
		I = [4];
		Hi = [5];
		Cnt = [6];

		@ = (I * Hi).equal -> Cnt,
			(D * N * K * I * Hi * (Cnt * (D * N * K * I).UpdRow).add).
				([1] * [2] * [3] * ([4] * 1).add * [5] * [6]).RowsSeq;
	}

	// (D * N * K * I) -> 1; обновляет строку I на месте
	// если D[I][K] = Inf, через K из I никуда не попасть - строка не меняется
	Fun UpdRow
	{
		D = [1];
		N = [2];
		K = [3];
		I = [4];

		Dik = ((D * I).arrayGet * K).arrayGet;

		@ = (Dik * Inf).gequal -> 1,
			((D * K).arrayGet * (D * I).arrayGet * Dik * N * 0).RowLoop;
	}

	// (RowK * Row * Dik * N * J) -> 1
	// Row[J] = min(Row[J], Dik + RowK[J]); запись только при улучшении
	Fun RowLoop
	{
		RowK = [1];
		Row = [2];
		Dik = [3];
		N = [4];
		J = [5];

		Dij = (Row * J).arrayGet;
		Dkj = (RowK * J).arrayGet;
		Next = (RowK * Row * Dik * N * (J * 1).add).RowLoop;

		@ = (J * N).equal -> 1,
			(Dkj * Inf).gequal -> Next,
			((Dik * Dkj).add * Dij).less ->
				(RowK * (Row * J * (Dik * Dkj).add).arraySet * Dik * N * (J * 1).add).RowLoop,
			Next;
	}

	// (D * N * I) -> true, если на диагонали есть отрицательный элемент
	Fun HasNegDiag
	{
		D = [1];
		N = [2];
		I = [3];

		@ = (I * N).equal -> false,
			(((D * I).arrayGet * I).arrayGet * 0).less -> true,
			(D * N * (I * 1).add).HasNegDiag;
	}

	// ---------------- вывод ----------------

	Fun RowToText
	{
		Row = [1];
		N = [2];
		J = [3];

		Cell = ((Row * J).arrayGet * Inf).gequal -> "0", (Row * J).arrayGet.toString;

		@ = ((J * 1).add * N).equal -> (Cell * "\n").cat,
			(Cell * " " * (Row * N * (J * 1).add).RowToText).cat;
	}

	Fun MatrToText
	{
		M = [1];
		N = [2];
		I = [3];

		@ = (I * N).equal -> "",
			(((M * I).arrayGet * N * 0).RowToText * (M * N * (I * 1).add).MatrToText).cat;
	}
}

Application
%FloydWarshall
