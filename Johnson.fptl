// Кратчайшие пути между всеми парами вершин: алгоритм Джонсона.
//   1) Беллман-Форд из фиктивной вершины q (дуги q->v веса 0) -> потенциалы h;
//      заодно обнаруживается цикл отрицательного веса;
//   2) перевзвешивание w'(u,v) = w(u,v) + h(u) - h(v) >= 0;
//   3) Дейкстра из каждой вершины по w';
//   4) d(u,v) = d'(u,v) - h(u) + h(v).
//
// Формат входного файла (целые числа через пробелы/переводы строк):
//   N
//   w11 w12 ... w1N
//   ...
//   wN1 wN2 ... wNN
// wij - вес дуги i->j (может быть отрицательным); 0 вне диагонали = дуги нет;
// диагональ игнорируется.
//
// Результат: матрица N x N расстояний; 0 - если j недостижима из i.

Scheme JohnsonAPSP
{
	@ = [1].readFile.(id -> Parse.Solve, "File not found!\n".print);

	// (text) -> (W * N)
	Parse = ([1] * "-?[0-9]+").getToken.([1].toInt * [2]).
			((([1] * ([1] * 0).arrayCreate).arrayCreate * [1] * 0 * [2]).ReadMatr * [1]);

	// (W * N) -> печать результата
	// h изначально нулевой: это и есть результат первой релаксации дуг q->v.
	// после "." кортеж: [1]=H [2]=ok [3]=W [4]=N
	Solve = (([1] * [2] * ([2] * 0).arrayCreate * 1).BellmanFord * [1] * [2]).
			([2] -> ((([3] * [4] * [1] * 0 * 0).Reweight * [4] * [1] * 0).JohnsonAll * [4] * 0).MatrToText.print,
					"Error: graph contains a negative cycle\n".print);

	// "бесконечность"
	Fun Inf
	{
		@ = 1000000000;
	}

	// ---------------- чтение графа ----------------

	// (w * i * j) -> вес во внутреннем представлении
	Fun ToWeight
	{
		W = [1];
		I = [2];
		J = [3];

		@ = (I * J).equal -> 0,
			(W * 0).equal -> Inf,
			W;
	}

	// (Row * N * I * J * Text) -> (Row * Rest)
	Fun ReadRow
	{
		Row = [1];
		N = [2];
		I = [3];
		J = [4];
		Text = [5];

		@ = (J * N).equal -> Row * Text,
			((Text * "-?[0-9]+").getToken.(id -> [1] * [2], "0" * "") * Row * N * I * J).
				(([3] * [6] * ([1].toInt * [5] * [6]).ToWeight).arraySet * [4] * [5] * ([6] * 1).add * [2]).ReadRow;
	}

	// (M * N * I * Text) -> M
	Fun ReadMatr
	{
		M = [1];
		N = [2];
		I = [3];
		Text = [4];

		@ = (I * N).equal -> M,
			(((N * 0).arrayCreate * N * I * 0 * Text).ReadRow * M * N * I).
				(([3] * [5] * [1]).arraySet * [4] * ([5] * 1).add * [2]).ReadMatr;
	}

	// ---------------- Беллман-Форд ----------------

	// один проход релаксации по всем дугам (U,V):
	// (W * N * H * U * V * Ch) -> (H * Ch), Ch = true, если что-то изменилось
	Fun BFPass
	{
		W = [1];
		N = [2];
		H = [3];
		U = [4];
		V = [5];
		Ch = [6];

		Wuv = ((W * U).arrayGet * V).arrayGet;
		Hu = (H * U).arrayGet;
		Next = (W * N * H * U * (V * 1).add * Ch).BFPass;

		@ = (U * N).equal -> H * Ch,
			(V * N).equal -> (W * N * H * (U * 1).add * 0 * Ch).BFPass,
			(Wuv * Inf).gequal -> Next,
			((Hu * Wuv).add * (H * V).arrayGet).less ->
				(W * N * (H * V * (Hu * Wuv).add).arraySet * U * (V * 1).add * true).BFPass,
			Next;
	}

	// (W * N * H * Iter) -> (H * ok)
	// Не более N проходов (в графе с вершиной q их N+1); если проход
	// с номером N всё ещё что-то меняет - есть отрицательный цикл (ok = false).
	// после "." кортеж: [1]=H [2]=Ch [3]=W [4]=N [5]=Iter
	Fun BellmanFord
	{
		W = [1];
		N = [2];
		H = [3];
		Iter = [4];

		@ = ((W * N * H * 0 * 0 * false).BFPass * W * N * Iter).
			([2] -> (([5] * [4]).equal -> [1] * false,
					 ([3] * [4] * [1] * ([5] * 1).add).BellmanFord),
				   [1] * true);
	}

	// ---------------- перевзвешивание ----------------

	// (W * N * H * U * V) -> W', где w'(u,v) = w(u,v) + h(u) - h(v)
	Fun Reweight
	{
		W = [1];
		N = [2];
		H = [3];
		U = [4];
		V = [5];

		Wuv = ((W * U).arrayGet * V).arrayGet;
		Next = (W * N * H * U * (V * 1).add).Reweight;

		@ = (U * N).equal -> W,
			(V * N).equal -> (W * N * H * (U * 1).add * 0).Reweight,
			(Wuv * Inf).gequal -> Next,
			((W * U * ((W * U).arrayGet * V * ((Wuv * (H * U).arrayGet).add * (H * V).arrayGet).sub).arraySet).arraySet *
			 N * H * U * (V * 1).add).Reweight;
	}

	// ---------------- алгоритм Дейкстры ----------------

	// (Dist * Used * N * V * B * BD) -> B
	// индекс непосещённой вершины с минимальным конечным Dist, либо N
	Fun MinVertex
	{
		Dist = [1];
		Used = [2];
		N = [3];
		V = [4];
		B = [5];
		BD = [6];

		Dv = (Dist * V).arrayGet;
		Next = (Dist * Used * N * (V * 1).add * B * BD).MinVertex;

		@ = (V * N).equal -> B,
			((Used * V).arrayGet * 0).nequal -> Next,
			(Dv * BD).less -> (Dist * Used * N * (V * 1).add * V * Dv).MinVertex,
			Next;
	}

	// (W * N * U * Du * Dist * V) -> Dist
	Fun Relax
	{
		W = [1];
		N = [2];
		U = [3];
		Du = [4];
		Dist = [5];
		V = [6];

		Wuv = ((W * U).arrayGet * V).arrayGet;
		Next = (W * N * U * Du * Dist * (V * 1).add).Relax;

		@ = (V * N).equal -> Dist,
			(Wuv * Inf).gequal -> Next,
			((Du * Wuv).add * (Dist * V).arrayGet).less ->
				(W * N * U * Du * (Dist * V * (Du * Wuv).add).arraySet * (V * 1).add).Relax,
			Next;
	}

	// (W * N * Dist * Used * Step) -> Dist
	// после "." кортеж: [1]=W [2]=N [3]=Dist [4]=Used [5]=Step [6]=U
	Fun DijkstraLoop
	{
		W = [1];
		N = [2];
		Dist = [3];
		Used = [4];
		Step = [5];

		U = (Dist * Used * N * 0 * N * Inf).MinVertex;

		@ = (Step * N).equal -> Dist,
			(W * N * Dist * Used * Step * U).
				(([6] * [2]).equal -> [3],
				 ([1] * [2] *
				  ([1] * [2] * [6] * ([3] * [6]).arrayGet * [3] * 0).Relax *
				  ([4] * [6] * 1).arraySet *
				  ([5] * 1).add).DijkstraLoop);
	}

	// (W * N * S) -> строка расстояний от S
	Fun Dijkstra
	{
		W = [1];
		N = [2];
		S = [3];

		@ = (W * N * ((N * Inf).arrayCreate * S * 0).arraySet * (N * 0).arrayCreate * 0).DijkstraLoop;
	}

	// ---------------- восстановление настоящих весов ----------------

	// (Row * N * H * S * V) -> Row, где d(S,v) = d'(S,v) - h(S) + h(v)
	Fun Restore
	{
		Row = [1];
		N = [2];
		H = [3];
		S = [4];
		V = [5];

		Rv = (Row * V).arrayGet;
		Next = (Row * N * H * S * (V * 1).add).Restore;

		@ = (V * N).equal -> Row,
			(Rv * Inf).gequal -> Next,
			((Row * V * ((Rv * (H * S).arrayGet).sub * (H * V).arrayGet).add).arraySet *
			 N * H * S * (V * 1).add).Restore;
	}

	// (W' * N * H * S) -> матрица расстояний (строки S..N-1).
	// Оба операнда "*" рекурсивны - запуски Дейкстры могут идти параллельно.
	Fun JohnsonAll
	{
		W = [1];
		N = [2];
		H = [3];
		S = [4];

		@ = (S * N).equal -> (N * (N * 0).arrayCreate).arrayCreate,
			(((W * N * S).Dijkstra * N * H * S * 0).Restore * (W * N * H * (S * 1).add).JohnsonAll * S).
				([2] * [3] * [1]).arraySet;
	}

	// ---------------- вывод ----------------

	Fun RowToText
	{
		Row = [1];
		N = [2];
		J = [3];

		Cell = ((Row * J).arrayGet * Inf).gequal -> "0", (Row * J).arrayGet.toString;

		@ = ((J * 1).add * N).equal -> (Cell * "\n").cat,
			(Cell * " " * (Row * N * (J * 1).add).RowToText).cat;
	}

	Fun MatrToText
	{
		M = [1];
		N = [2];
		I = [3];

		@ = (I * N).equal -> "",
			(((M * I).arrayGet * N * 0).RowToText * (M * N * (I * 1).add).MatrToText).cat;
	}
}

Application
%JohnsonAPSP
