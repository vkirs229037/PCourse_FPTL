// Кратчайшие пути между всеми парами вершин: алгоритм Дейкстры,
// запущенный из каждой вершины (вариант O(N^2) на массивах).
//
// Формат входного файла (целые числа через пробелы/переводы строк):
//   N
//   w11 w12 ... w1N
//   ...
//   wN1 wN2 ... wNN
// wij - вес дуги i->j; 0 вне диагонали = дуги нет; диагональ игнорируется.
// Для Дейкстры все веса должны быть неотрицательными.
//
// Результат: матрица N x N расстояний; 0 - если j недостижима из i.
// Внутри программы "нет пути" кодируется большим числом Inf.

Scheme DijkstraAPSP
{
	// чтение файла -> (W * N) -> решение
	@ = [1].readFile.(id -> Parse.Solve, "File not found!\n".print);

	// (text) -> (W * N)
	Parse = ([1] * "-?[0-9]+").getToken.([1].toInt * [2]).
			((([1] * ([1] * 0).arrayCreate).arrayCreate * [1] * 0 * [2]).ReadMatr * [1]);

	// (W * N) -> матрица расстояний (без вывода, чтобы не учитывать I/O во времени).
	// Чтобы снова печатать результат: (([1] * [2] * 0).AllDijkstra * [2] * 0).MatrToText.print
	Solve = ([1] * [2] * 0).MatrHasNeg -> "Error: Dijkstra's algorithm requires non-negative weights\n".print,
			([1] * [2] * 0).AllDijkstra;

	// "бесконечность"
	Fun Inf
	{
		@ = 1000000000;
	}

	// ---------------- чтение графа ----------------

	// (w * i * j) -> вес во внутреннем представлении
	Fun ToWeight
	{
		W = [1];
		I = [2];
		J = [3];

		@ = (I * J).equal -> 0,
			(W * 0).equal -> Inf,
			W;
	}

	// (Row * N * I * J * Text) -> (Row * Rest): читает строку I матрицы
	Fun ReadRow
	{
		Row = [1];
		N = [2];
		I = [3];
		J = [4];
		Text = [5];

		@ = (J * N).equal -> Row * Text,
			((Text * "-?[0-9]+").getToken.(id -> [1] * [2], "0" * "") * Row * N * I * J).
				(([3] * [6] * ([1].toInt * [5] * [6]).ToWeight).arraySet * [4] * [5] * ([6] * 1).add * [2]).ReadRow;
	}

	// (M * N * I * Text) -> M: заполняет строки I..N-1 (каждая строка - новый массив)
	Fun ReadMatr
	{
		M = [1];
		N = [2];
		I = [3];
		Text = [4];

		@ = (I * N).equal -> M,
			(((N * 0).arrayCreate * N * I * 0 * Text).ReadRow * M * N * I).
				(([3] * [5] * [1]).arraySet * [4] * ([5] * 1).add * [2]).ReadMatr;
	}

	// ---------------- проверка весов ----------------

	// (Row * N * J) -> true, если в строке есть отрицательный вес
	Fun RowHasNeg
	{
		Row = [1];
		N = [2];
		J = [3];

		@ = (J * N).equal -> false,
			((Row * J).arrayGet * 0).less -> true,
			(Row * N * (J * 1).add).RowHasNeg;
	}

	// (M * N * I) -> true, если в матрице есть отрицательный вес
	Fun MatrHasNeg
	{
		M = [1];
		N = [2];
		I = [3];

		@ = (I * N).equal -> false,
			((M * I).arrayGet * N * 0).RowHasNeg -> true,
			(M * N * (I * 1).add).MatrHasNeg;
	}

	// ---------------- алгоритм Дейкстры ----------------

	// (Dist * Used * N * V * B * BD) -> B
	// индекс непосещённой вершины с минимальным конечным Dist, либо N, если таких нет
	Fun MinVertex
	{
		Dist = [1];
		Used = [2];
		N = [3];
		V = [4];
		B = [5];
		BD = [6];

		Dv = (Dist * V).arrayGet;
		Next = (Dist * Used * N * (V * 1).add * B * BD).MinVertex;

		@ = (V * N).equal -> B,
			((Used * V).arrayGet * 0).nequal -> Next,
			(Dv * BD).less -> (Dist * Used * N * (V * 1).add * V * Dv).MinVertex,
			Next;
	}

	// (W * N * U * Du * Dist * V) -> Dist: релаксация всех дуг, выходящих из U
	Fun Relax
	{
		W = [1];
		N = [2];
		U = [3];
		Du = [4];
		Dist = [5];
		V = [6];

		Wuv = ((W * U).arrayGet * V).arrayGet;
		Next = (W * N * U * Du * Dist * (V * 1).add).Relax;

		@ = (V * N).equal -> Dist,
			(Wuv * Inf).gequal -> Next,
			((Du * Wuv).add * (Dist * V).arrayGet).less ->
				(W * N * U * Du * (Dist * V * (Du * Wuv).add).arraySet * (V * 1).add).Relax,
			Next;
	}

	// (W * N * Dist * Used * Step) -> Dist: основной цикл Дейкстры
	Fun DijkstraLoop
	{
		W = [1];
		N = [2];
		Dist = [3];
		Used = [4];
		Step = [5];

		U = (Dist * Used * N * 0 * N * Inf).MinVertex;

		// после "." кортеж: [1]=W [2]=N [3]=Dist [4]=Used [5]=Step [6]=U
		@ = (Step * N).equal -> Dist,
			(W * N * Dist * Used * Step * U).
				(([6] * [2]).equal -> [3],
				 ([1] * [2] *
				  ([1] * [2] * [6] * ([3] * [6]).arrayGet * [3] * 0).Relax *
				  ([4] * [6] * 1).arraySet *
				  ([5] * 1).add).DijkstraLoop);
	}

	// (W * N * S) -> строка расстояний от вершины S
	Fun Dijkstra
	{
		W = [1];
		N = [2];
		S = [3];

		@ = (W * N * ((N * Inf).arrayCreate * S * 0).arraySet * (N * 0).arrayCreate * 0).DijkstraLoop;
	}

	// (W * N * S) -> матрица, строки S..N-1 которой - результаты Дейкстры.
	// Оба операнда "*" рекурсивны, поэтому запуски из разных вершин
	// интерпретатор может выполнять параллельно.
	Fun AllDijkstra
	{
		W = [1];
		N = [2];
		S = [3];

		@ = (S * N).equal -> (N * (N * 0).arrayCreate).arrayCreate,
			((W * N * S).Dijkstra * (W * N * (S * 1).add).AllDijkstra * S).
				([2] * [3] * [1]).arraySet;
	}

	// ---------------- вывод ----------------

	// (Row * N * J) -> строка текста; Inf печатается как 0
	Fun RowToText
	{
		Row = [1];
		N = [2];
		J = [3];

		Cell = ((Row * J).arrayGet * Inf).gequal -> "0", (Row * J).arrayGet.toString;

		@ = ((J * 1).add * N).equal -> (Cell * "\n").cat,
			(Cell * " " * (Row * N * (J * 1).add).RowToText).cat;
	}

	// (M * N * I) -> текст матрицы начиная со строки I
	Fun MatrToText
	{
		M = [1];
		N = [2];
		I = [3];

		@ = (I * N).equal -> "",
			(((M * I).arrayGet * N * 0).RowToText * (M * N * (I * 1).add).MatrToText).cat;
	}
}

Application
%DijkstraAPSP
